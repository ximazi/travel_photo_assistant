# ============================================================
# Travel Photo Assistant - 环境配置
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略。
# 真实环境变量优先级高于 .env（见 src/travel_photo_assistant/env_loader.py）
# ============================================================

# ---------- 视觉模型适配器 ----------
# offline = 离线规则适配器（默认，无需 key，行为确定）
# gemini = Google Gemini
# openai = OpenAI 官方
# qwen   = 任意 OpenAI 兼容端点（阿里云百炼 / vLLM / one-api 等）
TPA_VISION_PROVIDER=offline

# 模型名（留空则用各适配器默认值）
# TPA_MODEL_NAME=gemini-2.5-flash
# TPA_MODEL_NAME=gpt-4o-mini
# TPA_MODEL_NAME=qwen-vl-max

# ---------- Gemini ----------
# 从 https://aistudio.google.com/apikey 获取
GEMINI_API_KEY=

# ---------- OpenAI / 兼容端点 ----------
OPENAI_API_KEY=
# 自建或第三方兼容端点时填写，OpenAI 官方留空即可
# OPENAI_BASE_URL=https://your-endpoint/v1

# ---------- 运行参数（可选） ----------
# 生产模式：true 时拒绝 example_only=true 与 source=synthetic_fixture 的数据
TPA_PRODUCTION_MODE=true

# 供应商请求超时（秒）。真实 VLM + 全分辨率照片 + 代理，30 秒会超时
TPA_REQUEST_TIMEOUT=120
